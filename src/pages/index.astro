---
import BaseLayout from "../layouts/BaseLayout.astro"
import Greeting from "../components/Greeting"
import profilepicture from "../images/me.png"
import { Image } from "astro:assets"
const pageTitle = "Hello World!"
---
<!-- clientload tells astro to send and rerun js on the client when the page loads, this is a hydrated component -->
<style>
	.aboutme {
		float: right;
		margin-left: 20px;
		border-left: 1px solid #efefef;
	}
	.profilepiccontainer {
		float: right;
		margin-left: 30px;
	}

	.profilepicture {
		height: auto;
		width: auto;
		max-width: 30vw;
		max-height: 30vh;
		border-radius: 15px;
	}

</style>

<BaseLayout pageTitle={pageTitle}>
	<!-- <Greeting client:load messages={["Hi", "Hello", "Hey there", "Good day", "Greetings"]}/>  -->
	<section class="segment">
		<div class="aboutme">
			<div class="profilepiccontainer">
				<Image src={ profilepicture } alt="A photo of me!" class="profilepicture"/>
				<h2>Helen Feng</h2>
				<p>Computer Science @ UCLA 2026</p>
			</div>
		</div>
	
		<div class="blurb">
			<p>
				I'm Helen, a student at UCLA (University of California, Los Angeles) majoring in Computer Science at the Samueli School of Engineering. 
				I've accumulated experience in full-stack development and machine learning through my years of studying Computer Science. I spent this summer in New York City 
				interning at Google as a Software Engineer Intern on the YouTube Living Room team, where I did full-stack development work in Typescript and C++ 
				to enable a cleaner development experience. The year before that, I spent my summer practicing my Chinese skills and interning at a Computer-Aided Engineering (CAE) 
				company in Chongqing, China, where I got experience developing in C++ with Qt. I am passionate about full-stack development for user-facing projects and hope 
				to continue working on similar things in the future!
			</p>
			<p>
				When I'm not learning about tech and working on projects, you can find me drawing, dancing in KPOP dance covers at KBM UCLA, and playing badminton in the 
				UCLA Badminton Club!
			</p>
			<p>
				Thanks for visiting my website!
			</p>
		</div>
	</section>

	<section class="segment" > 
		
	</section>



</BaseLayout>
